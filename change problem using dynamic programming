#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int coinChange(vector<int>& coins, int amount) {
    // Initialize DP table with a value greater than the max possible coins (amount + 1)
    vector<int> dp(amount + 1, amount + 1);
    
    // 0 coins are needed to make an amount of 0
    dp[0] = 0;

    for (int i = 1; i <= amount; ++i) {
        for (int coin : coins) {
            if (i - coin >= 0) {
                dp[i] = min(dp[i], dp[i - coin] + 1);
            }
        }
    }

    // If dp[amount] is still amount + 1, it means the amount cannot be formed
    return (dp[amount] > amount) ? -1 : dp[amount];
}

int main() {
    vector<int> coins = {1, 2, 5};
    int amount = 11;

    int result = coinChange(coins, amount);
    cout << "Minimum coins needed: " << result << endl; // Output: 3 (5 + 5 + 1)
    return 0;
}
